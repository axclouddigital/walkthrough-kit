{
  "name": "walkthrough-kit",
  "version": "0.2.1",
  "private": true,
  "description": "Records a web app's flows with Playwright at watching speed and composes each into a captioned MP4, a PDF of the steps and an index page.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.59.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
